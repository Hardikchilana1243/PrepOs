// ============================================================================
// PREPOS PRODUCTION PRISMA SCHEMA
// Database: PostgreSQL 16
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum UserRole {
  STUDENT
  ADMIN
  CONTENT_CREATOR
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  OUTDATED
  ARCHIVED
}

enum VeracityTier {
  OFFICIAL
  VERIFIED
  COMMUNITY_REPORTED
  ESTIMATED
  OUTDATED
}

enum SubmissionStatus {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
}

enum Language {
  CPP
  JAVA
  PYTHON
  JAVASCRIPT
}

enum RevisionConfidence {
  AGAIN
  HARD
  GOOD
  EASY
}

enum AssessmentAttemptStatus {
  STARTED
  IN_PROGRESS
  SUBMITTED
  EVALUATING
  EVALUATED
  EXPIRED
  ABANDONED
}

enum AssessmentSectionType {
  CODING
  CORE_CS
}

enum AssessmentQuestionType {
  CODING
  MCQ
}

// ----------------------------------------------------------------------------
// USER & AUTHENTICATION MODELS
// ----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth Relations
  accounts Account[]
  sessions Session[]

  // PrepOS Application Relations
  profile            Profile?
  submissions        Submission[]
  progress           UserProgress[]
  topicProgress      TopicProgress[]
  roadmapProgress    RoadmapProgress[]
  revisions          Revision[]
  quizAttempts       QuizAttempt[]
  assessmentAttempts AssessmentAttempt[]
  dailyMissions      DailyMission[]
  streakEvents       StreakEvent[]
  progressEvents     ProgressEvent[]
  readinessScore     ReadinessScore?
  scoreHistory       ReadinessScoreHistory[]
  bookmarks          Bookmark[]
  auditLogs          AdminAuditLog[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  gradYear       Int
  targetDegree   String // B.Tech, BCA, MCA
  targetRoleTier String // PRODUCT_TIER_1, TECH_TIER_2, SERVICE_TIER_3
  preferredLang  Language @default(CPP)
  streakDays     Int      @default(0)
  lastActiveAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// CONTENT & ROADMAP MODELS
// ----------------------------------------------------------------------------

model Roadmap {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String        @db.Text
  durationDays Int           @default(90)
  status       ContentStatus @default(PUBLISHED)
  orderIndex   Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  modules         Module[]
  roadmapProgress RoadmapProgress[]

  @@index([slug, status])
}

model Module {
  id          String   @id @default(cuid())
  roadmapId   String
  slug        String
  title       String
  description String?  @db.Text
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@unique([roadmapId, slug])
  @@index([roadmapId])
}

model Topic {
  id          String   @id @default(cuid())
  moduleId    String
  slug        String
  title       String
  description String?  @db.Text
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module        Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  problems      Problem[]
  topicProgress TopicProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId])
}

model Lesson {
  id          String        @id @default(cuid())
  topicId     String
  slug        String
  title       String
  content     String        @db.Text
  videoUrl    String?
  durationMin Int           @default(15)
  orderIndex  Int           @default(0)
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, slug])
  @@index([topicId])
}

model Problem {
  id                      String        @id @default(cuid())
  topicId                 String
  slug                    String        @unique
  title                   String
  statement               String        @db.Text
  difficulty              Difficulty
  constraints             String        @db.Text
  hints                   String[]
  expectedTimeComplexity  String?
  expectedSpaceComplexity String?
  status                  ContentStatus @default(PUBLISHED)
  veracity                VeracityTier  @default(VERIFIED)
  sourceUrl               String?
  acceptedCount           Int           @default(0)
  submittedCount          Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  topic               Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  testCases           TestCase[]
  solutions           Solution[]
  companyProblems     CompanyProblem[]
  submissions         Submission[]
  revisions           Revision[]
  userProgress        UserProgress[]
  bookmarks           Bookmark[]
  assessmentQuestions AssessmentQuestion[]

  @@index([slug, difficulty, status])
  @@index([topicId])
}

model TestCase {
  id          String  @id @default(cuid())
  problemId   String
  input       String  @db.Text
  expected    String  @db.Text
  isSecret    Boolean @default(false)
  explanation String? @db.Text
  orderIndex  Int     @default(0)

  problem              Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)
  executions           Execution[]
  assessmentExecutions AssessmentExecution[]

  @@index([problemId, isSecret])
}

model Solution {
  id              String   @id @default(cuid())
  problemId       String
  language        Language
  code            String   @db.Text
  editorial       String   @db.Text
  timeComplexity  String
  spaceComplexity String
  createdAt       DateTime @default(now())

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, language])
  @@index([problemId])
}

// ----------------------------------------------------------------------------
// COMPANY PATTERN MODELS
// ----------------------------------------------------------------------------

model Company {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  logoUrl     String?
  description String?  @db.Text
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patterns        CompanyPattern[]
  companyProblems CompanyProblem[]
  assessments     Assessment[]

  @@index([slug])
}

model CompanyPattern {
  id             String       @id @default(cuid())
  companyId      String
  patternName    String
  frequencyPct   Int          @default(50)
  veracity       VeracityTier @default(VERIFIED)
  lastVerifiedAt DateTime     @default(now())
  createdAt      DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CompanyProblem {
  id        String       @id @default(cuid())
  companyId String
  problemId String
  frequency Int          @default(1)
  veracity  VeracityTier @default(VERIFIED)
  notes     String?      @db.Text
  createdAt DateTime     @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([companyId, problemId])
  @@index([companyId])
  @@index([problemId])
}

model Assessment {
  id              String        @id @default(cuid())
  slug            String        @unique
  companyId       String
  title           String
  description     String?       @db.Text
  instructions    String?       @db.Text
  durationMin     Int           @default(90)
  totalMarks      Float         @default(100.0)
  totalQuestions  Int           @default(0)
  passingScorePct Float         @default(60.0)
  difficulty      Difficulty    @default(MEDIUM)
  status          ContentStatus @default(PUBLISHED)
  veracity        VeracityTier  @default(VERIFIED)
  orderIndex      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sections AssessmentSection[]
  attempts AssessmentAttempt[]

  @@index([companyId])
  @@index([slug, status])
  @@index([status])
}

model AssessmentSection {
  id           String                @id @default(cuid())
  assessmentId String
  title        String
  description  String?               @db.Text
  type         AssessmentSectionType
  orderIndex   Int                   @default(0)
  timeLimitMin Int?
  totalMarks   Float                 @default(50.0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  assessment    Assessment               @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions     AssessmentQuestion[]
  sectionScores AssessmentSectionScore[]

  @@unique([assessmentId, orderIndex])
  @@index([assessmentId])
}

model AssessmentQuestion {
  id            String                 @id @default(cuid())
  sectionId     String
  type          AssessmentQuestionType
  problemId     String?
  mcqQuestionId String?
  orderIndex    Int                    @default(0)
  marks         Float                  @default(10.0)
  negativeMarks Float                  @default(0.0)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  section     AssessmentSection            @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  problem     Problem?                     @relation(fields: [problemId], references: [id], onDelete: SetNull)
  mcqQuestion MCQQuestion?                 @relation(fields: [mcqQuestionId], references: [id], onDelete: SetNull)
  answers     AssessmentAnswer[]
  submissions AssessmentCodingSubmission[]

  @@unique([sectionId, orderIndex])
  @@index([sectionId])
  @@index([problemId])
  @@index([mcqQuestionId])
}

model AssessmentAttempt {
  id               String                  @id @default(cuid())
  userId           String
  assessmentId     String
  attemptNumber    Int                     @default(1)
  status           AssessmentAttemptStatus @default(STARTED)
  startedAt        DateTime                @default(now())
  expiresAt        DateTime
  submittedAt      DateTime?
  evaluatedAt      DateTime?
  totalScore       Float                   @default(0.0)
  maxPossibleScore Float                   @default(0.0)
  scorePct         Float                   @default(0.0)
  passed           Boolean                 @default(false)
  durationTakenSec Int                     @default(0)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  user          User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment    Assessment                   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers       AssessmentAnswer[]
  submissions   AssessmentCodingSubmission[]
  sectionScores AssessmentSectionScore[]

  @@index([userId, assessmentId])
  @@index([userId, status])
  @@index([assessmentId, status])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

model AssessmentAnswer {
  id               String    @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  codeDraft        String?   @db.Text
  codeLanguage     Language?
  isCorrect        Boolean?
  marksAwarded     Float     @default(0.0)
  evaluatedAt      DateTime?
  lastSavedAt      DateTime  @default(now())

  attempt        AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption?    @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model AssessmentCodingSubmission {
  id            String           @id @default(cuid())
  attemptId     String
  questionId    String
  language      Language
  code          String           @db.Text
  status        SubmissionStatus
  passedTests   Int              @default(0)
  totalTests    Int              @default(0)
  executionTime Int?
  memoryKb      Int?
  errorLog      String?          @db.Text
  marksEarned   Float            @default(0.0)
  createdAt     DateTime         @default(now())

  attempt    AssessmentAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  executions AssessmentExecution[]

  @@index([attemptId, questionId])
  @@index([attemptId, createdAt])
}

model AssessmentExecution {
  id              String           @id @default(cuid())
  submissionId    String
  testCaseId      String
  status          SubmissionStatus
  actualOutput    String?          @db.Text
  executionTimeMs Int?
  memoryKb        Int?
  createdAt       DateTime         @default(now())

  submission AssessmentCodingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase                   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model AssessmentSectionScore {
  id                 String   @id @default(cuid())
  attemptId          String
  sectionId          String
  score              Float    @default(0.0)
  maxScore           Float    @default(0.0)
  scorePct           Float    @default(0.0)
  questionsAttempted Int      @default(0)
  questionsCorrect   Int      @default(0)
  totalQuestions     Int      @default(0)
  createdAt          DateTime @default(now())

  attempt AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  section AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, sectionId])
  @@index([attemptId])
}

// ----------------------------------------------------------------------------
// CORE CS & QUIZ MODELS
// ----------------------------------------------------------------------------

model CoreCSSubject {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?  @db.Text
  icon        String?
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())

  quizzes CoreCSQuiz[]

  @@index([slug])
}

model CoreCSQuiz {
  id             String   @id @default(cuid())
  subjectId      String
  slug           String
  title          String
  description    String?  @db.Text
  durationMin    Int      @default(10)
  totalQuestions Int      @default(10)
  orderIndex     Int      @default(0)
  createdAt      DateTime @default(now())

  subject   CoreCSSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions MCQQuestion[]
  attempts  QuizAttempt[]

  @@unique([subjectId, slug])
  @@index([subjectId])
}

model MCQQuestion {
  id           String   @id @default(cuid())
  quizId       String
  questionText String   @db.Text
  explanation  String   @db.Text
  orderIndex   Int      @default(0)
  createdAt    DateTime @default(now())

  quiz                CoreCSQuiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options             QuestionOption[]
  quizAnswers         QuizAnswer[]
  assessmentQuestions AssessmentQuestion[]

  @@index([quizId])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  optionText String  @db.Text
  isCorrect  Boolean @default(false)
  orderIndex Int     @default(0)

  question          MCQQuestion        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  quizAnswers       QuizAnswer[]
  assessmentAnswers AssessmentAnswer[]

  @@index([questionId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  scorePct    Float
  totalQs     Int
  correctQs   Int
  durationSec Int      @default(0)
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    CoreCSQuiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([userId, quizId])
  @@index([userId, completedAt])
}

model QuizAnswer {
  id               String  @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean @default(false)

  attempt        QuizAttempt    @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       MCQQuestion    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption QuestionOption @relation(fields: [selectedOptionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

// ----------------------------------------------------------------------------
// EXECUTION & SUBMISSIONS
// ----------------------------------------------------------------------------

model Submission {
  id            String           @id @default(cuid())
  userId        String
  problemId     String
  language      Language
  code          String           @db.Text
  status        SubmissionStatus
  executionTime Int?
  memoryKb      Int?
  passedTests   Int              @default(0)
  totalTests    Int              @default(0)
  errorLog      String?          @db.Text
  createdAt     DateTime         @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem    Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)
  executions Execution[]

  @@index([userId, problemId, status])
  @@index([createdAt])
  @@index([userId, problemId, createdAt])
}

model Execution {
  id              String           @id @default(cuid())
  submissionId    String
  testCaseId      String
  status          SubmissionStatus
  actualOutput    String?          @db.Text
  executionTimeMs Int?
  memoryKb        Int?
  createdAt       DateTime         @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testCase   TestCase   @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// ----------------------------------------------------------------------------
// USER PROGRESS, STREAK & REVISION
// ----------------------------------------------------------------------------

model UserProgress {
  id          String    @id @default(cuid())
  userId      String
  problemId   String
  isSolved    Boolean   @default(false)
  solvedAt    DateTime?
  attemptsCnt Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, isSolved])
  @@index([userId, isSolved, problemId])
}

model TopicProgress {
  id          String   @id @default(cuid())
  userId      String
  topicId     String
  solvedCount Int      @default(0)
  totalCount  Int      @default(0)
  isCompleted Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
}

model RoadmapProgress {
  id               String   @id @default(cuid())
  userId           String
  roadmapId        String
  completedModules Int      @default(0)
  totalModules     Int      @default(0)
  progressPct      Float    @default(0.0)
  updatedAt        DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([userId, roadmapId])
  @@index([userId])
}

model DailyMission {
  id          String    @id @default(cuid())
  userId      String
  date        DateTime
  title       String
  description String?   @db.Text
  type        String // DSA, CORE_CS, APTITUDE
  targetId    String?
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, title])
  @@index([userId, date])
}

model Revision {
  id           String             @id @default(cuid())
  userId       String
  problemId    String
  intervalDays Int                @default(7)
  confidence   RevisionConfidence @default(GOOD)
  dueAt        DateTime
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, dueAt, completedAt])
  @@index([userId, completedAt, dueAt])
}

model StreakEvent {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime
  activityType String // SUBMISSION, QUIZ, REVISION
  count        Int      @default(1)
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, activityType])
  @@index([userId, date])
}

model ProgressEvent {
  id        String   @id @default(cuid())
  userId    String
  eventType String // PROBLEM_SOLVED, QUIZ_COMPLETED, REVISION_DONE
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ----------------------------------------------------------------------------
// READINESS SCORE MODELS
// ----------------------------------------------------------------------------

model ReadinessScore {
  id          String   @id @default(cuid())
  userId      String   @unique
  totalScore  Int      @default(20)
  dsaScore    Int      @default(0)
  coreCsScore Int      @default(0)
  oaScore     Int      @default(0)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReadinessScoreHistory {
  id         String   @id @default(cuid())
  userId     String
  score      Int
  recordedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
}

// ----------------------------------------------------------------------------
// OTHER SUPPORTING MODELS
// ----------------------------------------------------------------------------

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
}

model ContentSource {
  id           String       @id @default(cuid())
  name         String
  url          String
  veracityTier VeracityTier @default(VERIFIED)
  description  String?      @db.Text
  createdAt    DateTime     @default(now())

  @@index([url])
}

model AdminAuditLog {
  id           String   @id @default(cuid())
  userId       String
  action       String
  targetEntity String
  targetId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
